{
  "name": "monsmith",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npx hardhat test",
    "test:coverage": "npx hardhat coverage",
    "compile": "npx hardhat compile",
    "clean": "npx hardhat clean",
    "type-check": "tsc --noEmit",
    "test:chainfit": "node --import tsx --import ./tests/register.mjs --test tests/*.test.ts",
    "test:all": "npm run test:chainfit && npm test",
    "test:unit": "node --experimental-strip-types --import ./tests/register.mjs --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.1",
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/evm": "^10.1.3",
    "@ethereumjs/statemanager": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@monaco-editor/react": "^4.7.0",
    "@neondatabase/serverless": "^1.1.0",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@openzeppelin/contracts": "^5.4.0",
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.87.1",
    "@types/d3": "^7.4.3",
    "chai": "^4.5.0",
    "framer-motion": "^12.23.26",
    "hardhat": "^2.27.1",
    "hardhat-gas-reporter": "^2.3.0",
    "jose": "^6.2.12",
    "lenis": "^1.3.26",
    "lucide-react": "^0.559.0",
    "next": "^16.3.4",
    "posthog-js": "^1.424.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reactflow": "^11.11.4",
    "solc": "^0.8.31",
    "solidity-coverage": "^0.8.16",
    "three": "^0.180.0",
    "uuid": "^13.0.0",
    "viem": "^2.41.2",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.25",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.180.0",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "description": "Monsmith: browser IDE for building, auditing and shipping smart contracts on the Monad network.",
  "main": "index.js",
  "keywords": [
    "monad",
    "solidity",
    "smart-contracts",
    "ide",
    "web3",
    "parallel-evm",
    "hardhat"
  ],
  "author": "Adwait Keshari",
  "license": "MIT",
  "type": "module"
}
