# Copy to .env.local and fill in. Never commit real keys - .env* is gitignored.

# ─── AI provider ────────────────────────────────────────────────────────────
# At least one is required for the AI actions (generate, architect, audit,
# explain_error, research). Compile, deploy and transfer work without any.
# Tried in order: OpenAI → OpenRouter → Groq → ChainGPT.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Any model slug from https://openrouter.ai/models
# (default: nvidia/nemotron-3-ultra-550b-a55b:free)
OPENROUTER_MODEL=
GROQ_API_KEY=
CHAINGPT_API_KEY=

# ─── Chain ──────────────────────────────────────────────────────────────────
# Deployer / q402 facilitator wallet. Required for `deploy` and `transfer`.
# Use a burner key funded from https://faucet.monad.xyz - never a real wallet.
PRIVATE_KEY=

# Optional: verifies deployed contracts and powers the ETH → Monad migration
# importer (https://etherscan.io/myapikey).
ETHERSCAN_API_KEY=

# ─── Analytics (optional) ───────────────────────────────────────────────────
# Without these, analytics silently no-op and the app runs normally.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Misc (optional) ────────────────────────────────────────────────────────
# Public URL, used for OpenRouter usage attribution.
NEXT_PUBLIC_SITE_URL=
