# Copy to .env.local and fill in. Never commit real keys - .env* is gitignored.

# ─── AI provider ────────────────────────────────────────────────────────────
# At least one is required for the AI actions (generate, architect, audit,
# explain_error, research). Compile, deploy and transfer work without any.
# Tried in order: OpenAI → OpenRouter → Groq → ChainGPT.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Any model slug from https://openrouter.ai/models
# (default: nvidia/nemotron-3-ultra-550b-a55b:free)
OPENROUTER_MODEL=
GROQ_API_KEY=
CHAINGPT_API_KEY=

# ─── Chain ──────────────────────────────────────────────────────────────────
# Deployer / q402 facilitator wallet. Required for `deploy` and `transfer`.
# Use a burner key funded from https://faucet.monad.xyz - never a real wallet.
PRIVATE_KEY=

# Optional: verifies deployed contracts and powers the ETH → Monad migration
# importer (https://etherscan.io/myapikey).
ETHERSCAN_API_KEY=

# ─── Analytics (optional) ───────────────────────────────────────────────────
# Without these, analytics silently no-op and the app runs normally.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── PostHog (optional) ─────────────────────────────────────────────────────
# Product analytics + DeltaV traction. Use the PROJECT token (starts with phc_)
# from PostHog > Settings > Project > General. It is write-only and safe in a
# public app. Do NOT use the personal phx_ key here (that one goes into DeltaV).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Auth (optional) ────────────────────────────────────────────────────────
# Without these the app runs anonymously: every public surface still works and
# every viewer resolves to the free tier.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma separated. These addresses are admins regardless of profile metadata,
# which is the only way to become one without a deploy.
CLERK_ADMIN_EMAILS=

# ─── GitHub import (optional) ───────────────────────────────────────────────
# Without these, pasting a public repository URL still works. These add private
# repositories and the repository picker.
#
# Register at https://github.com/settings/apps/new with:
#   Permissions: Repository -> Contents (Read-only), Metadata (Read-only)
#   Callback URL: <your site>/api/github/callback
#   Webhook: unchecked
#   Where can this be installed: Any account
# Then generate a private key and paste its PEM below (newlines may be \n).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=

# ─── Paid reports (off by default) ──────────────────────────────────────────
# The half-report split is built and tested but dormant. Set to "on" to start
# charging; anything else, including absent, serves every report in full.
REPORTS_PAYWALL=
# How many reports each person gets free before paying, counted from their
# earliest. Default 2. 0 charges from the first report.
REPORTS_FREE=

# Optimizations a signed-in account gets free before optimizing needs a paid
# report. Defaults to 2; same rules as REPORTS_FREE.
OPTIMIZATIONS_FREE=

# OpenRouter model ids the optimizer tries first, comma separated, before the
# default chain. Defaults to deepseek/deepseek-v4.1-flash, then
# deepseek/deepseek-v4-flash, then qwen/qwen3-coder-next: well under a cent a run.
OPTIMIZER_MODEL=
# Wallet that receives report unlocks. Falls back to the agent route's payee.
# Both are server-authoritative and are never read from a request body.
REPORT_PAYEE=
# Positive integer string, in wei. Default: 0.05 MON.
REPORT_PRICE_WEI=

# Card payments through Dodo Payments (optional; unset means no card checkout).
# Secret API key from the Dodo dashboard. Test and live keys are different.
DODO_PAYMENTS_API_KEY=
# "test_mode" (default) or "live_mode". Unset stays in test mode on purpose.
DODO_PAYMENTS_ENVIRONMENT=
# One-time product that unlocks one report. Its price is the price shown.
DODO_REPORT_PRODUCT_ID=
# Signing secret (whsec_...) of the webhook endpoint pointed at
# https://<your-domain>/api/webhooks/dodo
DODO_PAYMENTS_WEBHOOK_KEY=

# ─── Misc (optional) ────────────────────────────────────────────────────────
# Public URL, used for OpenRouter usage attribution.
NEXT_PUBLIC_SITE_URL=
